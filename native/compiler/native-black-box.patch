+/// Return `value` through an opaque native optimization barrier.
+///
+/// Useful for benchmarking: optimizers cannot assume the returned value equals
+/// the input or eliminate the call, even when its result is unused. It does not
+/// read, write, or retain Fe-managed memory. This is a scalar benchmark hint,
+/// not a hardware memory fence or a constant-time/security guarantee.
+/// Native executables and tests automatically link the required runtime helper.
+pub fn black_box_u64(_ value: u64) -> u64 {
+    __fe_native_black_box_u64(value)
+}
