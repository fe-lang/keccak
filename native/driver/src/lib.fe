// Binary requests: '@', rounds/chunk/length as LE u64, then input bytes.
// Responses: LE u64 CPU ticks, 32 digest bytes, LE u64 checksum of all rounds.
use std::io::{HostIo, Read, Write, host, read_char}
use std::native::{ByteBuffer, black_box_u64, cpu_clock_ticks}
use keccak::Keccak256

fn read64() -> u64 uses (input: mut Read) {
    var value: u64 = 0
    var index: u64 = 0
    while index < 8 {
        let byte = read_char()
        core::assert(byte >= 0)
        let bits: u64 = byte.downcast_unchecked()
        value |= bits << (index * 8)
        index += 1
    }
    value
}

fn write_byte(_ value: u8) uses (output: mut HostIo) {
    output.write_char(c: value as i32)
    core::assert(!output.failed())
}

fn write64(_ value: u64) uses (output: mut HostIo) {
    var index: u64 = 0
    while index < 8 {
        write_byte((value >> (index * 8)).downcast_truncate())
        index += 1
    }
}

#[inline(never)]
fn hash_runtime(_ input: ByteBuffer, len: u64, chunk: u64) -> [u8; 32] {
    var state = Keccak256::new()
    if chunk == 0 {
        state.update(input, offset: 0, len)
    } else {
        var offset: u64 = 0
        while offset < len {
            let take = if chunk < len - offset { chunk } else { len - offset }
            state.update(input, offset, len: take)
            offset += take
        }
    }
    state.finish()
}

pub fn main() -> i32 {
    with (Read = host(), HostIo = host()) {
        var marker = read_char()
        while marker != -1 {
            core::assert(marker == 64)
            let rounds = read64()
            let chunk = read64()
            let len = read64()
            core::assert(rounds > 0 && rounds <= 1_000_000_000 && len <= 64 * 1024 * 1024)
            var input = ByteBuffer::new()
            core::assert(input.try_resize(len))
            var index: u64 = 0
            while index < len {
                let byte = read_char()
                core::assert(byte >= 0)
                input.set_byte(index, value: byte.downcast_unchecked())
                index += 1
            }
            var result: [u8; 32] = [0; 32]
            var checksum: u64 = 0
            var iteration: u64 = 0
            let started = cpu_clock_ticks()
            while iteration < rounds {
                result = hash_runtime(input, len: black_box_u64(len), chunk)
                var word: u64 = 0
                index = 0
                while index < 8 {
                    word |= (result[index as usize] as u64) << (index * 8)
                    index += 1
                }
                checksum = ((checksum << 1) | (checksum >> 63)) ^ word ^ iteration
                iteration += 1
            }
            let ended = cpu_clock_ticks()
            core::assert(started >= 0 && ended >= started)
            write64((ended - started).downcast_unchecked())
            for byte in result { write_byte(byte) }
            write64(checksum)
            input.release()
            marker = read_char()
        }
    }
    0
}
