// Keccak-f[1600], indexed x + 5*y. Constants and round definition:
// https://keccak.team/keccak_specs_summary.html
const ROUND_CONSTANTS: [u64; 24] = [
    0x0000000000000001, 0x0000000000008082, 0x800000000000808a, 0x8000000080008000,
    0x000000000000808b, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
    0x000000000000008a, 0x0000000000000088, 0x0000000080008009, 0x000000008000000a,
    0x000000008000808b, 0x800000000000008b, 0x8000000000008089, 0x8000000000008003,
    0x8000000000008002, 0x8000000000000080, 0x000000000000800a, 0x800000008000000a,
    0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008,
]
const ROTATIONS: [u64; 25] = [
    0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39,
    41, 45, 15, 21, 8, 18, 2, 61, 56, 14,
]

fn rotate(_ value: u64, by: u64) -> u64 {
    if by == 0 { value } else { (value << by) | (value >> (64 - by)) }
}

pub fn permute(_ state: mut [u64; 25]) {
    let mut round: usize = 0
    while round < 24 {
        let mut columns: [u64; 5] = [0; 5]
        let mut x: usize = 0
        while x < 5 {
            columns[x] = state[x] ^ state[x + 5] ^ state[x + 10] ^ state[x + 15] ^ state[x + 20]
            x += 1
        }
        x = 0
        while x < 5 {
            let delta = columns[(x + 4) % 5] ^ rotate(columns[(x + 1) % 5], by: 1)
            let mut y: usize = 0
            while y < 5 {
                state[x + 5 * y] ^= delta
                y += 1
            }
            x += 1
        }
        let mut rotated: [u64; 25] = [0; 25]
        x = 0
        while x < 5 {
            let mut y: usize = 0
            while y < 5 {
                rotated[y + 5 * ((2 * x + 3 * y) % 5)] = rotate(state[x + 5 * y], by: ROTATIONS[x + 5 * y])
                y += 1
            }
            x += 1
        }
        x = 0
        while x < 5 {
            let mut y: usize = 0
            while y < 5 {
                state[x + 5 * y] = rotated[x + 5 * y] ^ (!rotated[(x + 1) % 5 + 5 * y] & rotated[(x + 2) % 5 + 5 * y])
                y += 1
            }
            x += 1
        }
        state[0] ^= ROUND_CONSTANTS[round]
        round += 1
    }
}
