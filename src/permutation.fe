// Keccak-f[1600], indexed x + 5*y. Small counters use u64 because Fe usize
// has 256-bit arithmetic, including on native targets. Constants and round definition:
// https://keccak.team/keccak_specs_summary.html
const ROUND_CONSTANTS: [u64; 24] = [
    0x0000000000000001, 0x0000000000008082, 0x800000000000808a, 0x8000000080008000,
    0x000000000000808b, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
    0x000000000000008a, 0x0000000000000088, 0x0000000080008009, 0x000000008000000a,
    0x000000008000808b, 0x800000000000008b, 0x8000000000008089, 0x8000000000008003,
    0x8000000000008002, 0x8000000000000080, 0x000000000000800a, 0x800000008000000a,
    0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008,
]

#[inline(always)]
fn rotate(_ value: u64, by: u64) -> u64 {
    (value << by) | (value >> (64 - by))
}

// The fixed 5x5 round exposes constant lane indices and rotation amounts.
// Keep only the 24-round loop; no run-time modulo or temporary lane arrays.
pub fn permute(_ state: mut [u64; 25]) {
    var round: u64 = 0
    while round < 24 {
        // Theta: column parities and their neighboring deltas.
        let c0 = state[0] ^ state[5] ^ state[10] ^ state[15] ^ state[20]
        let c1 = state[1] ^ state[6] ^ state[11] ^ state[16] ^ state[21]
        let c2 = state[2] ^ state[7] ^ state[12] ^ state[17] ^ state[22]
        let c3 = state[3] ^ state[8] ^ state[13] ^ state[18] ^ state[23]
        let c4 = state[4] ^ state[9] ^ state[14] ^ state[19] ^ state[24]
        let d0 = c4 ^ rotate(c1, by: 1)
        let d1 = c0 ^ rotate(c2, by: 1)
        let d2 = c1 ^ rotate(c3, by: 1)
        let d3 = c2 ^ rotate(c4, by: 1)
        let d4 = c3 ^ rotate(c0, by: 1)

        // Rho/Pi: rotate each theta-adjusted lane into its new position.
        let b0 = state[0] ^ d0
        let b10 = rotate(state[1] ^ d1, by: 1)
        let b20 = rotate(state[2] ^ d2, by: 62)
        let b5 = rotate(state[3] ^ d3, by: 28)
        let b15 = rotate(state[4] ^ d4, by: 27)
        let b16 = rotate(state[5] ^ d0, by: 36)
        let b1 = rotate(state[6] ^ d1, by: 44)
        let b11 = rotate(state[7] ^ d2, by: 6)
        let b21 = rotate(state[8] ^ d3, by: 55)
        let b6 = rotate(state[9] ^ d4, by: 20)
        let b7 = rotate(state[10] ^ d0, by: 3)
        let b17 = rotate(state[11] ^ d1, by: 10)
        let b2 = rotate(state[12] ^ d2, by: 43)
        let b12 = rotate(state[13] ^ d3, by: 25)
        let b22 = rotate(state[14] ^ d4, by: 39)
        let b23 = rotate(state[15] ^ d0, by: 41)
        let b8 = rotate(state[16] ^ d1, by: 45)
        let b18 = rotate(state[17] ^ d2, by: 15)
        let b3 = rotate(state[18] ^ d3, by: 21)
        let b13 = rotate(state[19] ^ d4, by: 8)
        let b14 = rotate(state[20] ^ d0, by: 18)
        let b24 = rotate(state[21] ^ d1, by: 2)
        let b9 = rotate(state[22] ^ d2, by: 61)
        let b19 = rotate(state[23] ^ d3, by: 56)
        let b4 = rotate(state[24] ^ d4, by: 14)

        // Chi: every output row reads the complete pre-Chi row.
        state[0] = b0 ^ (!b1 & b2)
        state[1] = b1 ^ (!b2 & b3)
        state[2] = b2 ^ (!b3 & b4)
        state[3] = b3 ^ (!b4 & b0)
        state[4] = b4 ^ (!b0 & b1)
        state[5] = b5 ^ (!b6 & b7)
        state[6] = b6 ^ (!b7 & b8)
        state[7] = b7 ^ (!b8 & b9)
        state[8] = b8 ^ (!b9 & b5)
        state[9] = b9 ^ (!b5 & b6)
        state[10] = b10 ^ (!b11 & b12)
        state[11] = b11 ^ (!b12 & b13)
        state[12] = b12 ^ (!b13 & b14)
        state[13] = b13 ^ (!b14 & b10)
        state[14] = b14 ^ (!b10 & b11)
        state[15] = b15 ^ (!b16 & b17)
        state[16] = b16 ^ (!b17 & b18)
        state[17] = b17 ^ (!b18 & b19)
        state[18] = b18 ^ (!b19 & b15)
        state[19] = b19 ^ (!b15 & b16)
        state[20] = b20 ^ (!b21 & b22)
        state[21] = b21 ^ (!b22 & b23)
        state[22] = b22 ^ (!b23 & b24)
        state[23] = b23 ^ (!b24 & b20)
        state[24] = b24 ^ (!b20 & b21)

        // Iota.
        state[0] ^= ROUND_CONSTANTS[round as usize]
        round += 1
    }
}
