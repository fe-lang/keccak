use core::{MemBuffer, MemSpan}
use core::num::swap_bytes
use ingot::permutation::permute

/// Read-only bytes. Implementations must accept every index below `len()`.
/// Hashing borrows its source and never allocates or retains a reference to it.
pub trait ByteSource {
    fn len(self) -> usize
    fn byte_at(self, _ index: usize) -> u8

    /// The 8 bytes from `index` on as a little-endian integer, for every
    /// `index` with `index + 8 <= len()`.
    fn lane_at(self, _ index: usize) -> u64 {
        var lane: u64 = 0
        for byte in 0..8 { lane |= (self.byte_at(index + byte) as u64) << (byte * 8).downcast_unchecked() }
        lane
    }
}

impl<const N: usize> ByteSource for [u8; N] {
    fn len(self) -> usize { N }
    fn byte_at(self, _ index: usize) -> u8 { self[index] }
}

impl ByteSource for MemBuffer {
    fn len(self) -> usize { MemBuffer::len(self) }
    fn byte_at(self, _ index: usize) -> u8 { self[index] }
    fn lane_at(self, _ index: usize) -> u64 { self.read_le<u64>(index) }
}

impl ByteSource for MemSpan {
    fn len(self) -> usize { MemSpan::len(self) }
    fn byte_at(self, _ index: usize) -> u8 { self[index] }
    fn lane_at(self, _ index: usize) -> u64 { self.read_le<u64>(index) }
}

/// Ethereum's Keccak-256: 136-byte rate, 512-bit capacity, suffix 0x01.
/// This is distinct from the SHA3-256 variant, whose suffix is 0x06.
pub struct Keccak256 { lanes: [u64; 25], position: usize }

impl Keccak256 {
    pub fn new() -> Self { Self { lanes: [0; 25], position: 0 } }

    /// Absorb a source range. Empty updates do not change the hash state.
    pub fn update<T: ByteSource>(mut self, _ input: T, offset: usize, len: usize) {
        core::assert(offset <= input.len() && len <= input.len() - offset)
        // Bytes up to a lane boundary, then whole lanes, then the rest.
        var index: usize = 0
        while index < len && self.position % 8 != 0 {
            self.absorb_byte(input.byte_at(offset + index))
            index += 1
        }
        // Whole lanes. `index + remaining` stays `len`, and `offset + len`
        // fits the input, so the additions cannot wrap.
        var remaining = len - index
        while remaining >= 8 {
            self.lanes[self.position / 8] ^= input.lane_at(offset.wrapping_add(index))
            self.advance(8)
            index = index.wrapping_add(8)
            remaining -= 8
        }
        while index < len {
            self.absorb_byte(input.byte_at(offset + index))
            index += 1
        }
    }

    /// Absorb the last `len` (at most 32) bytes of `value`'s big-endian
    /// encoding: 32 for a word, 20 for an address, 1 for a byte.
    pub fn update_word(mut self, _ value: u256, len: usize) {
        core::assert(len <= 32)
        // Bytes up to a lane boundary, then whole lanes, then the rest. The
        // bytes still to absorb are the low `remaining` of `value`.
        var remaining = len
        while remaining > 0 && self.position % 8 != 0 {
            remaining -= 1
            self.absorb_byte((value >> (remaining * 8) as u256).downcast_truncate())
        }
        while remaining >= 8 {
            remaining -= 8
            let lane: u64 = (value >> (remaining * 8) as u256).downcast_truncate()
            self.lanes[self.position / 8] ^= swap_bytes(lane)
            self.advance(8)
        }
        while remaining > 0 {
            remaining -= 1
            self.absorb_byte((value >> (remaining * 8) as u256).downcast_truncate())
        }
    }

    fn absorb_byte(mut self, _ byte: u8) {
        self.lanes[self.position / 8] ^= (byte as u64) << ((self.position % 8) * 8).downcast_unchecked()
        self.advance(1)
    }

    /// Count `bytes` more absorbed bytes, permuting at the end of a block.
    fn advance(mut self, _ bytes: usize) {
        self.position += bytes
        if self.position == 136 {
            permute(mut self.lanes)
            self.position = 0
        }
    }

    fn pad(mut self) {
        self.lanes[self.position / 8] ^= 1 << ((self.position % 8) * 8).downcast_unchecked()
        self.lanes[16] ^= 0x8000000000000000
        permute(mut self.lanes)
    }

    /// Apply Keccak padding and return the digest as a big-endian word, as
    /// the EVM's `KECCAK256` does, consuming the state.
    pub fn finish_word(var own self) -> u256 {
        self.pad()
        ((swap_bytes(self.lanes[0]) as u256) << 192)
            | ((swap_bytes(self.lanes[1]) as u256) << 128)
            | ((swap_bytes(self.lanes[2]) as u256) << 64)
            | (swap_bytes(self.lanes[3]) as u256)
    }

    /// Apply Keccak padding, return the digest, and consume the state.
    pub fn finish(var own self) -> [u8; 32] {
        self.pad()
        var digest: [u8; 32] = [0; 32]
        for index in 0..32 {
            digest[index] = (self.lanes[index / 8] >> ((index % 8) * 8).downcast_unchecked()).downcast_truncate()
        }
        digest
    }
}

pub fn keccak256<T: ByteSource>(_ input: T) -> [u8; 32] {
    var state = Keccak256::new()
    state.update(input, offset: 0, len: input.len())
    state.finish()
}

/// The digest of `input` as a big-endian word; see `Keccak256::finish_word`.
pub fn keccak256_word<T: ByteSource>(_ input: T) -> u256 {
    var state = Keccak256::new()
    state.update(input, offset: 0, len: input.len())
    state.finish_word()
}
